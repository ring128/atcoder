{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run main tests (in.txt -> out.txt)",
      "type": "shell",
      "command": "${workspaceFolder}/acrun",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "clear": false,
        "panel": "shared"
      },
      "problemMatcher": "$gcc"
    }
  ]
}
