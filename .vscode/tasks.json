{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run main (in.txt -> out.txt)",
      "type": "shell",
      "command": "g++ -std=c++20 -O2 -Wall -Wextra \"${workspaceFolder}/main/main.cpp\" -o /tmp/atcoder-main && /tmp/atcoder-main < \"${workspaceFolder}/main/in.txt\" > \"${workspaceFolder}/main/out.txt\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "clear": false,
        "panel": "shared"
      },
      "problemMatcher": "$gcc"
    }
  ]
}
