{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run main tests (in.txt -> out.txt)",
      "type": "shell",
      "command": "${workspaceFolder}/acrun",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "clear": false,
        "panel": "shared"
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "run main tests (Clang)",
      "type": "shell",
      "command": "clang++ -std=c++23 -stdlib=libc++ -O2 -Wall -Wextra -pedantic-errors \"${workspaceFolder}/main/main.cpp\" -o /tmp/atcoder-main-clang && /tmp/atcoder-main-clang < \"${workspaceFolder}/main/in.txt\" > \"${workspaceFolder}/main/out.txt\"",
      "presentation": {
        "reveal": "always",
        "clear": false,
        "panel": "shared"
      },
      "problemMatcher": "$gcc"
    }
  ]
}
