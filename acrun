#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source="$root/main/main.cpp"
input="$root/main/in.txt"
output="$root/main/out.txt"
binary="/tmp/atcoder-main"
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

g++ -std=c++20 -O2 -Wall -Wextra "$source" -o "$binary"

touch "$tmpdir/000001.in"
awk -v dir="$tmpdir" '
  BEGIN { n = 1; file = sprintf("%s/%06d.in", dir, n) }
  $0 == "-" { close(file); n++; file = sprintf("%s/%06d.in", dir, n); next }
  { print > file }
  END { close(file) }
' "$input"

: > "$output"
first=1
for case_file in "$tmpdir"/*.in; do
  if (( ! first )); then
    printf '\n---\n' >> "$output"
  fi
  "$binary" < "$case_file" >> "$output"
  first=0
done
